{
  "name": "portfoliov2",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "writer": "node tools/writer/server.mjs",
    "lint": "eslint scripts tools src --ext .js,.mjs --max-warnings 0",
    "audit:facts": "node scripts/audit-facts.mjs",
    "qa": "node scripts/qa.mjs",
    "check": "npm run lint && npm run validate && npm run build && npm run audit:facts && npm run qa",
    "deploy": "npm run check && gh-pages -d dist --dotfiles",
    "validate": "node scripts/validate-content.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "eslint": "^8.57.0",
    "gh-pages": "^6.1.1",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "marked": "^18.0.14"
  }
}
